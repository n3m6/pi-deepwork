{
  "name": "deepwork-pi",
  "version": "0.1.0",
  "description": "QRSPI deepwork pipeline extension for pi — automated multi-stage agent orchestration via subagents",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .js,.ts,.cjs,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test ./test/*.test.js ./dist/test/*.test.js ./dist/test/agents/*.test.js",
    "test:watch": "npm run build && tsc -p tsconfig.test.json && node --test --watch ./test/*.test.js ./dist/test/*.test.js ./dist/test/agents/*.test.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "files": [
    "dist/",
    "agents/",
    "skills/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n3m6/pi-deepwork.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/n3m6/pi-deepwork/issues"
  },
  "homepage": "https://github.com/n3m6/pi-deepwork#readme",
  "peerDependencies": {
    "@tintinweb/pi-subagents": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3"
  }
}
